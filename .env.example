# ---------------------------------------------------------------------------
# Database (required)
# Neon PostgreSQL connection string. Find it in the Neon console under
# Connection Details → Connection string. Use the pooled mode URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth (required)
# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-random-32-char-string"

# Public base URL of the app. In production set this to your Vercel URL
# (e.g. https://your-project.vercel.app). Falls back to VERCEL_URL in Vercel.
BETTER_AUTH_URL="http://localhost:3000"
